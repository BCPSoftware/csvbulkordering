<?php
/**
 * @var Template $block
 * @var Escaper $escaper
 * @var OrderUpload $viewModel
 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Oporteo\OrderUpload\ViewModel\OrderUpload;

$viewModel = $block->getData('view_model');

?>

<?php if ($viewModel->canUpload()): ?>
    <p class="order-upload__template">
        <a href="<?= $escaper->escapeUrl($viewModel->getTemplateUrl()) ?>">
            <?= $escaper->escapeHtml(__('Click here to get template file.')) ?>
        </a>
    </p>
<?php endif; ?>
